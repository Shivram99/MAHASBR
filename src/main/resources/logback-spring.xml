<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ========================= -->
    <!-- Spring Properties -->
    <!-- ========================= -->
    <springProperty name="APP_NAME"
                    source="spring.application.name"
                    defaultValue="mahasbr"/>

    <!-- Logs go to OS temp by default; override with logging.file.path -->
    <springProperty name="LOG_PATH"
                    source="logging.file.path"
                    defaultValue="${java.io.tmpdir}/${APP_NAME}/logs"/>
    <!-- ========================= -->
    <!-- Console Appender -->
    <!-- (Docker / K8s / Dev) -->
    <!-- ========================= -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level
                [%thread] [%X{correlationId}]
                %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- Rolling File Appender -->
    <!-- PROD / ELK Source -->
    <!-- ========================= -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/${APP_NAME}.log</file>

        <rollingPolicy
            class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- Daily + size based -->
            <fileNamePattern>
                ${LOG_PATH}/archive/${APP_NAME}-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <!-- Max 100MB per file -->
            <maxFileSize>100MB</maxFileSize>

            <!-- Keep 30 days -->
            <maxHistory>30</maxHistory>

            <!-- Total disk cap -->
            <totalSizeCap>10GB</totalSizeCap>

            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level
                [%thread] [%X{correlationId}]
                %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- Root Logger -->
    <!-- ========================= -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- ========================= -->
    <!-- Noise Reduction -->
    <!-- ========================= -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

</configuration><!--  -->
